# FinAI backend configuration.
# Copy to .env and adjust. NEVER commit the real .env.

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-real-secret

# development | production
ENV=development

# SQLite for zero-setup development. PostgreSQL for anything shared, e.g.:
# postgresql+psycopg://finai:finai@localhost:5432/finai
DATABASE_URL=sqlite:///./finai.db

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

DISCLAIMER_VERSION=1.0.0
